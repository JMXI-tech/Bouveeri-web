# Copy to .env and fill in. Never commit .env.
DOMAIN=boveeri.ng
DB_PASSWORD=change-me-long-random
JWT_SECRET=change-me-at-least-32-random-characters-long
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-strong-password
GMAIL_USER=yourhotel@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
HOTEL_INBOX=yourhotel@gmail.com
# AI chatbot (get a key at console.anthropic.com). Leave blank to disable the chatbot.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-haiku-5-5
# Paystack (dashboard.paystack.com > Settings > API Keys). Use the TEST secret key first.
PAYSTACK_SECRET_KEY=
SITE_URL=https://boveeri.ng
